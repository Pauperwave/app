{
  "permissions": {
    "allow": [
      "Bash(git push origin v*)",
      "Bash(gh release create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-push.mjs"]
          }
        ]
      }
    ]
  }
}
