{
  "name": "nuxt-ui-template-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:clean": "rimraf .nuxt .output .vercel && nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && git config core.hooksPath .githooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "check:paths": "node scripts/check-file-paths.mjs",
    "check:paths:fix": "node scripts/check-file-paths.mjs --fix",
    "supabase:types": "supabase gen types typescript --project-id uggrolzdntoamclgnzrt --schema public > shared/utils/types/database.ts",
    "geocode:associates": "node --env-file=.env scripts/geocode-associates.mjs",
    "geocode:missing": "node --env-file=.env scripts/list-missing-geocodes.mjs",
    "backfill:wanted-cards-scryfall": "node --env-file=.env scripts/backfill-wanted-cards-scryfall.mjs",
    "refresh:wanted-cards-prices": "node --env-file=.env scripts/refresh-wanted-cards-prices.mjs",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:audit": "fallow audit --format json",
    "fallow:health": "fallow health --score --hotspots --targets",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "cross-env PW_SLOWMO=1 playwright test",
    "release": "changelogen --release"
  },
  "dependencies": {
    "@dicebear/core": "10.4.0",
    "@dicebear/styles": "10.4.0",
    "@formkit/auto-animate": "^0.10.0",
    "@iconify-json/circle-flags": "1.2.10",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@internationalized/date": "^3.12.3",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/leaflet": "1.3.2",
    "@nuxtjs/robots": "^6.1.4",
    "@nuxtjs/supabase": "2.0.10",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/colada-plugin-cache-persister": "^1.1.1",
    "@pinia/nuxt": "^1.0.1",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "fast-levenshtein": "^3.0.0",
    "libphonenumber-js": "^1.13.10",
    "mana-font": "1.18.0",
    "markdown-it": "^15.0.0",
    "motion-v": "^2.3.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-echarts": "^1.0.1",
    "pinia": "^4.0.2",
    "slugify": "1.6.9",
    "tailwindcss": "^4.3.3",
    "uisfx": "^0.4.0",
    "valibot": "^1.4.2",
    "vue-draggable-plus": "^0.6.1",
    "vue-echarts": "^8.1.0",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "fallow": "^3.14.0",
    "happy-dom": "^20.11.2",
    "rimraf": "^6.1.3",
    "supabase": "^2.113.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "resolutions": {
    "unimport": "4.1.1"
  },
  "packageManager": "pnpm@10.17.1"
}
