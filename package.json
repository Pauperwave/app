{
  "name": "nuxt-ui-template-dashboard",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:clean": "rimraf .nuxt .output .vercel && nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && git config core.hooksPath .githooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "check:paths": "node scripts/check-file-paths.mjs",
    "check:paths:fix": "node scripts/check-file-paths.mjs --fix",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:components": "node scripts/check-component-names.mjs",
    "supabase:types": "supabase gen types typescript --project-id uggrolzdntoamclgnzrt --schema public > shared/utils/types/database.ts",
    "geocode:associates": "node --env-file=.env scripts/geocode-associates.mjs",
    "geocode:missing": "node --env-file=.env scripts/list-missing-geocodes.mjs",
    "backfill:wanted-cards-scryfall": "node --env-file=.env scripts/backfill-wanted-cards-scryfall.mjs",
    "refresh:wanted-cards-prices": "node --env-file=.env scripts/refresh-wanted-cards-prices.mjs",
    "telegram:set-webhook": "node --env-file=.env scripts/telegram-set-webhook.mjs",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:dupes:report": "node scripts/fallow-dupes-report.mjs",
    "fallow:dupes:markers": "node scripts/fallow-dupes-markers-check.mjs",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:health:report": "node scripts/fallow-health-report.mjs",
    "fallow:security": "fallow security",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "cross-env PW_SLOWMO=1 playwright test",
    "release": "changelogen --release"
  },
  "dependencies": {
    "@dicebear/core": "10.6.0",
    "@dicebear/styles": "10.5.0",
    "@formkit/auto-animate": "^0.10.0",
    "@grammyjs/commands": "^1.4.0",
    "@grammyjs/menu": "^1.5.0",
    "@grammyjs/parse-mode": "^2.3.0",
    "@iconify-json/circle-flags": "1.2.10",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/simple-icons": "^1.2.98",
    "@internationalized/date": "^3.12.4",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/leaflet": "1.3.2",
    "@nuxtjs/robots": "^6.2.3",
    "@nuxtjs/supabase": "2.0.10",
    "@pinia/colada": "^1.4.6",
    "@pinia/colada-nuxt": "^1.2.0",
    "@pinia/colada-plugin-cache-persister": "^1.1.2",
    "@pinia/nuxt": "^1.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "echarts": "^6.1.0",
    "fast-levenshtein": "^3.0.0",
    "grammy": "^1.46.0",
    "libphonenumber-js": "^1.13.14",
    "mana-font": "1.18.0",
    "markdown-it": "^15.0.2",
    "motion-v": "^2.5.1",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-echarts": "^1.1.0",
    "pinia": "^4.0.3",
    "reka-ui": "2.10.3",
    "slugify": "1.6.9",
    "tailwindcss": "^4.3.3",
    "uisfx": "^0.4.0",
    "valibot": "^1.5.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-echarts": "^8.3.1",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "fallow": "^3.30.0",
    "happy-dom": "^20.14.5",
    "rimraf": "^6.1.3",
    "supabase": "^2.118.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "resolutions": {
    "unimport": "4.1.1",
    "h3": "1.15.11",
    "typescript": "6.0.3",
    "@tanstack/vue-table": "8.21.3"
  },
  "packageManager": "pnpm@10.17.1"
}
